DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=gestion_incidencias
DB_USER=gestion_user
DB_PASSWORD=change_me
DB_HOST=sgi-db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# PostgreSQL container variables
POSTGRES_DB=gestion_incidencias
POSTGRES_USER=gestion_user
POSTGRES_PASSWORD=change_me

# Render puede usar DATABASE_URL en lugar de DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT.
DATABASE_URL=
REDIS_URL=redis://sgi-redis:6379/0
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DJANGO_SECRET_KEY=change-me-in-production
